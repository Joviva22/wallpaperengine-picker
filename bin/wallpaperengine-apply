#!/usr/bin/env bash
# Aplica wallpapers de Wallpaper Engine, uno por pantalla, cada uno en su PROPIO proceso
# de linux-wallpaperengine. Asi, si el motor crashea al renderizar un wallpaper concreto
# (ocurre con algunas escenas rotas/incompatibles), solo se cae esa pantalla y no las demas.
# Uso: wallpaperengine-apply PANTALLA=ID [PANTALLA=ID ...]
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
source "$SCRIPT_DIR/wallpaperengine-common.sh"

STEAM_LIB=$(wpe_get_steam_library)
WORKSHOP_DIR="$STEAM_LIB/steamapps/workshop/content/$WPE_APPID"
ASSETS_DIR="$STEAM_LIB/steamapps/common/wallpaper_engine/assets"
CONF_DIR="$WPE_CONF_DIR"
CURRENT_FILE="$CONF_DIR/current.json"

if [[ $# -eq 0 ]]; then
    echo "Uso: wallpaperengine-apply PANTALLA=ID [PANTALLA=ID ...]" >&2
    exit 1
fi

mkdir -p "$CONF_DIR"

declare -A ASSIGN
# Partimos de lo que ya estaba guardado, para no perder la configuracion de pantallas
# que no se mencionan en esta llamada.
if [[ -f "$CURRENT_FILE" ]]; then
    while IFS=$'\t' read -r screen id; do
        [[ -n "$screen" ]] && ASSIGN["$screen"]="$id"
    done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$CURRENT_FILE" 2>/dev/null)
fi

for pair in "$@"; do
    screen="${pair%%=*}"
    id="${pair#*=}"
    if [[ -z "$screen" || -z "$id" || "$screen" == "$pair" ]]; then
        echo "Formato invalido: '$pair' (usa PANTALLA=ID)" >&2
        exit 1
    fi
    if [[ ! -d "$WORKSHOP_DIR/$id" ]]; then
        echo "No existe el wallpaper con id $id en $WORKSHOP_DIR" >&2
        exit 1
    fi
    ASSIGN["$screen"]="$id"
done

KNOWN_BAD_FILE="$CONF_DIR/known_bad.json"

# Espera un poco tras lanzar un wallpaper y comprueba si el proceso murio con una
# excepcion/crash tipico del motor; si es asi, lo apunta en known_bad.json para que
# la app lo marque en la lista. Si sigue vivo y antes estaba marcado, lo desmarca solo.
watch_for_crash() {
    local screen="$1" id="$2" pid="$3" logfile="$4"
    sleep 8

    local current="{}"
    [[ -s "$KNOWN_BAD_FILE" ]] && current=$(cat "$KNOWN_BAD_FILE")

    if kill -0 "$pid" 2>/dev/null; then
        echo "$current" | jq --arg id "$id" 'del(.[$id])' > "$KNOWN_BAD_FILE" 2>/dev/null || true
        return
    fi

    if grep -qE "terminate called|Segmentation fault|Aborted \(core dumped\)" "$logfile" 2>/dev/null; then
        echo "$current" | jq --arg id "$id" --arg screen "$screen" --arg ts "$(date -Iseconds)" \
            '.[$id] = {screen: $screen, detected_at: $ts}' > "$KNOWN_BAD_FILE" 2>/dev/null || true
    fi
}

restart_screen() {
    local screen="$1" id="$2"
    local pidfile="$CONF_DIR/pid_${screen}.pid"
    local logfile="$CONF_DIR/wallpaperengine_${screen}.log"

    if [[ -f "$pidfile" ]]; then
        local old_pid
        old_pid=$(cat "$pidfile" 2>/dev/null || true)
        if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
            kill "$old_pid" 2>/dev/null || true
            sleep 0.3
            kill -0 "$old_pid" 2>/dev/null && kill -9 "$old_pid" 2>/dev/null || true
        fi
    fi

    nohup linux-wallpaperengine --assets-dir "$ASSETS_DIR" --fps 30 --silent \
        --screen-root "$screen" --bg "$WORKSHOP_DIR/$id" --scaling fill --clamp border \
        >>"$logfile" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$pidfile"
    disown

    ( watch_for_crash "$screen" "$id" "$new_pid" "$logfile" ) &
    disown
}

for pair in "$@"; do
    screen="${pair%%=*}"
    id="${pair#*=}"
    restart_screen "$screen" "$id"
    echo "  $screen -> $id"
done

tmp=$(jq -n '{}')
for screen in "${!ASSIGN[@]}"; do
    tmp=$(echo "$tmp" | jq --arg k "$screen" --arg v "${ASSIGN[$screen]}" '. + {($k): $v}')
done
echo "$tmp" > "$CURRENT_FILE"
